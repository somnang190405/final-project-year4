# Copy this file to .env (do NOT commit .env)
# Used for generating a scannable ABA KHQR QR code with the correct order amount.

# Provider display text on the Payment page
VITE_PAYMENT_PROVIDER_NAME=ABA PAY

# Merchant name shown on the Payment page
VITE_PAYMENT_MERCHANT_NAME=RITH SOMNANG

# Paste the RAW ABA/KHQR payload string here (the EMVCo text, not a URL, not an image).
# Your bank app should have an option like: "Share KHQR" / "Copy KHQR string" / "Merchant QR data".
# Example format starts with digits like: 000201...
VITE_ABA_KHQR_BASE_PAYLOAD=

# Supabase storage settings for admin image upload
# Replace these with your actual Supabase project URL and anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For Next.js use, copy the same values into NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://rumglikboxhaemrtpyhq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SM8wuSw4l_Tp54zTUfFkfQ_mNfBaFGb