# Copy this file to .env (do NOT commit .env)
# Used for generating a scannable ABA KHQR QR code with the correct order amount.

# Provider display text on the Payment page
VITE_PAYMENT_PROVIDER_NAME=ABA PAY

# Merchant name shown on the Payment page
VITE_PAYMENT_MERCHANT_NAME=RITH SOMNANG

# Paste the RAW ABA/KHQR payload string here (the EMVCo text, not a URL, not an image).
# Your bank app should have an option like: "Share KHQR" / "Copy KHQR string" / "Merchant QR data".
# Example format starts with digits like: 000201...
VITE_ABA_KHQR_BASE_PAYLOAD=

# ===== FIREBASE CONFIGURATION =====
# Get these values from your Firebase Console -> Project Settings -> Your App
# These are essential for authentication, database, and image storage
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Gemini API Key (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin emails (comma-separated list of emails that should have admin access)
VITE_ADMIN_EMAILS=admin@example.com,your-email@example.com